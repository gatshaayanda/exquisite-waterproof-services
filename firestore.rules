rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function isAdmin(){return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['owner','staff','Owner','Staff'];}
  function validEnquiry(){return request.resource.data.keys().hasOnly(['createdAt','name','phone','problem','preferredContact','location','notes','status']) && request.resource.data.keys().hasAll(['createdAt','name','phone','problem','preferredContact','location','notes','status']) && request.resource.data.createdAt is string && request.resource.data.name is string && request.resource.data.phone is string && request.resource.data.problem is string && request.resource.data.preferredContact in ['whatsapp','phone'] && request.resource.data.location is string && request.resource.data.notes is string && request.resource.data.status == 'New';}
  function validSettings(){return request.resource.data.keys().hasOnly(['serviceText','phone','whatsapp','location','hours','locationNote','updatedAt']) && request.resource.data.serviceText is string && request.resource.data.phone is string && request.resource.data.whatsapp is string && request.resource.data.location is string && request.resource.data.hours is string && request.resource.data.locationNote is string && request.resource.data.updatedAt is string;}
  match /admins/{uid}{allow read:if signedIn()&&request.auth.uid==uid;allow create,update,delete:if false;}
  match /enquiries/{id}{allow create:if validEnquiry();allow read:if isAdmin();allow update:if isAdmin();allow delete:if isAdmin();}
  match /businessSettings/{id}{allow read:if true;allow create,update:if isAdmin()&&validSettings();allow delete:if false;}
  match /{document=**}{allow read,write:if false;}
 }
}